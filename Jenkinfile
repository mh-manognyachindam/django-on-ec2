pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '000629889765'
        AWS_REGION = 'us-east-1'
        IMAGE_NAME = 'django-todo'
        ECR_REPO = 'todo-ecr-repo'
        EC2_USER = 'ubuntu'
        EC2_HOST = '44.201.139.171'
        SSH_KEY = '/var/lib/jenkins/.ssh/pro2.pem'
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    try {
                        checkout scm
                    } catch (Exception e) {
                        error "❌ Code Checkout Failed: ${e.message}"
                    }
                }
            }
        }

        stage('Run Pylint Tests') {
            steps {
                script {
                    try {
                        sh '''
                        chmod +x ./pylint.sh
                        ./pylint.sh | tee pylint.log || echo "❌ Pylint issues found, review pylint.log."
                        '''
                    } catch (Exception e) {
                        error "❌ Pylint Tests Failed: ${e.message}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    try {
                        sh '''
                        docker system prune -f
                        docker build -t $IMAGE_NAME:latest .
                        docker tag $IMAGE_NAME:latest $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                        '''
                    } catch (Exception e) {
                        error "❌ Docker Build Failed: ${e.message}"
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    try {
                        sh '''
                        aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                        docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                        '''
                    } catch (Exception e) {
                        error "❌ ECR Push Failed: ${e.message}"
                    }
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                script {
                    try {
                        sh '''
                        ssh -o StrictHostKeyChecking=no -i $SSH_KEY $EC2_USER@$EC2_HOST << EOF
                        docker pull $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                        docker stop django-todo || true
                        docker rm django-todo || true
                        docker run -d --name django-todo -p 8000:8000 $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                        EOF
                        '''
                    } catch (Exception e) {
                        error "❌ Deployment Failed: ${e.message}"
                    }
                }
            }
        }
    }

    post {
        always {
            echo '🟢 Pipeline Completed!!!'
        }
        failure {
            echo '❗ Pipeline Failed — Please Check Logs.'
        }
    }
}
