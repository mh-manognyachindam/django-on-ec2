pipeline {
    agent { label 'testing-lable' }

    environment {
        AWS_ACCOUNT_ID = '000629889765'
        AWS_REGION = 'us-east-1'
        EC2_USER = 'ubuntu'
        EC2_HOST = '18.234.185.185'
        APP_DIR = '/home/ubuntu/todo-app'
        PYTHON_BIN = '/usr/bin/python3'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Run Pylint Checks (Local)') {
            steps {
                sh '''
                echo "Running Pylint Checks on Jenkins..."
                if [ -f pylint.sh ]; then
                    chmod +x pylint.sh
                    ./pylint.sh || echo "Pylint warnings found, review the logs."
                else
                    echo "pylint.sh not found in repository."
                fi
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['d1c7a6e0-3239-4488-a6da-520ac8757e2b']) {
                    sh '''
                    set -e  # Stop on error

                    echo "Creating app directory on EC2..."
                    ssh -o StrictHostKeyChecking=no $EC2_USER@$EC2_HOST "mkdir -p $APP_DIR"

                    echo "Transferring application files to EC2..."
                    scp -o StrictHostKeyChecking=no -r * $EC2_USER@$EC2_HOST:$APP_DIR

                    echo "Running Pylint Checks on EC2..."
                    ssh -o StrictHostKeyChecking=no $EC2_USER@$EC2_HOST << EOF
                    set -e
                    cd $APP_DIR
                    if [ -f pylint.sh ]; then
                        chmod +x pylint.sh
                        ./pylint.sh || echo "Pylint warnings found, review the logs."
                    else
                        echo "pylint.sh not found on EC2."
                    fi
                    EOF

                    echo "Deployment Successful!"
                    '''
                }
            }
        }
    }
}
