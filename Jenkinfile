pipeline {
    agent { label 'testing-lable' }

    environment {
        AWS_ACCOUNT_ID = '000629889765'
        AWS_REGION = 'us-east-1'
        EC2_USER = 'ubuntu'
        EC2_HOST = '18.234.185.185'
        APP_DIR = '/home/ubuntu/jenkins/jenkins/workspace/ngo-ToDo-Direct-Pipeline_develop'
        PYTHON_BIN = '/usr/bin/python3'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Run Pylint Checks (Local)') {
            steps {
                sh '''
                echo "Running Pylint Checks on Jenkins..."
                if [ -f ./pylint.sh ]; then
                    chmod +x ./pylint.sh
                    ./pylint.sh | tee pylint.log || echo "Pylint warnings found, review pylint.log."
                else
                    echo "❌ pylint.sh not found in repository. Skipping local pylint checks."
                fi
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                script {
                    if (!fileExists('pylint.sh')) {
                        echo "❌ WARNING: pylint.sh not found in the workspace. Skipping pylint checks."
                    }
                }

                withCredentials([sshUserPrivateKey(credentialsId: 'd1c7a6e0-3239-4488-a6da-520ac8757e2b', keyFileVariable: 'SSH_KEY')]) {
                    sh '''
                    set -e  # Stop on error

echo "Creating app directory on EC2..."
ssh -o StrictHostKeyChecking=no -i $SSH_KEY $EC2_USER@$EC2_HOST "mkdir -p $APP_DIR"

echo "Setting correct permissions..."
ssh -o StrictHostKeyChecking=no -i $SSH_KEY $EC2_USER@$EC2_HOST "sudo chown -R ubuntu:ubuntu $APP_DIR"

echo "Transferring application files to EC2 using rsync..."
rsync -avz --exclude '.git' -e "ssh -i $SSH_KEY -o StrictHostKeyChecking=no" ./ $EC2_USER@$EC2_HOST:$APP_DIR || echo "❌ rsync transfer failed."

echo "Running Pylint Checks on EC2..."
ssh -tt -o StrictHostKeyChecking=no -i $SSH_KEY $EC2_USER@$EC2_HOST bash -c "
set -e
cd $APP_DIR
if [ -f pylint.sh ]; then
    chmod +x pylint.sh
    ./pylint.sh | tee pylint.log || echo 'Pylint warnings found, review pylint.log.'
else
    echo '❌ pylint.sh not found on EC2.'
fi

echo 'Installing dependencies...'
python3 -m venv venv
source venv/bin/activate
pip install -r requirements.txt

echo 'Running migrations...'
python manage.py migrate

echo 'Starting Django server...'
nohup python manage.py runserver 0.0.0.0:8000 &
"
                    '''
                }
            }
        }
    }
}
