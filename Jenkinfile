pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '000629889765'
        AWS_REGION = 'us-east-1'
        IMAGE_NAME = 'django-todo'
        ECR_REPO = 'todo-ecr-repo'
        EC2_USER = 'ubuntu'
        EC2_HOST = '44.201.139.171'
        SSH_CREDENTIAL_ID = 'd1c7a6e0-3239-4488-a6da-520ac8757e2b'
    }

    stages {
        stage('Checkout Code') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',  // Add your GitHub credential ID
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_PASSWORD'
                )]) {
                    script {
                        try {
                            sh '''
                            git clone https://$GIT_USERNAME:$GIT_PASSWORD@github.com/mh-manognyachindam/django-on-ec2.git
                            cd <your-repo> || exit 1
                            echo "✅ Code checkout successful."
                            '''
                        } catch (Exception e) {
                            error "❌ Code Checkout Failed: ${e.message}"
                        }
                    }
                }
            }
        }

        stage('Run Pylint Tests') {
            steps {
                script {
                    try {
                        sh '''
                        echo "🔍 Running Pylint Tests....."
                        if [ -f ./pylint.sh ]; then
                            chmod +x ./pylint.sh
                            ./pylint.sh | tee pylint.log || echo "⚠️ Pylint issues found, review pylint.log."
                        else
                            echo "❗ pylint.sh not found — Skipping Pylint Tests."
                        fi
                        '''
                    } catch (Exception e) {
                        error "❌ Pylint Tests Failed: ${e.message}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    try {
                        sh '''
                        echo "🛠️ Building Docker Image..."
                        docker image prune -f
                        docker container prune -f
                        docker build -t $IMAGE_NAME:latest .
                        docker tag $IMAGE_NAME:latest $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                        '''
                    } catch (Exception e) {
                        error "❌ Docker Build Failed: ${e.message}"
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding', 
                    credentialsId: 'awscredentials'
                ]]) {
                    sh '''
                    aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                    docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                    '''
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['d1c7a6e0-3239-4488-a6da-520ac8757e2b']) {
                    script {
                        try {
                            sh '''
                            echo "🚀 Checking SSH connectivity..."
                            ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no $EC2_USER@$EC2_HOST "echo 'SSH Connected Successfully'" || exit 1

                            echo "🚀 Deploying to EC2..."
                            ssh -o StrictHostKeyChecking=no $EC2_USER@$EC2_HOST << EOF
                            sudo systemctl start docker || echo "⚠️ Docker already running"
                            docker pull $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                            docker stop django-todo || true
                            docker rm django-todo || true
                            docker run -d --name django-todo -p 8000:8000 $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
                            EOF
                            '''
                        } catch (Exception e) {
                            error "❌ Deployment Failed: ${e.message}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo '🟢 Pipeline Completed!!!'
        }
        failure {
            echo '❗ Pipeline Failed — Please Check Logs.'
        }
    }
}
